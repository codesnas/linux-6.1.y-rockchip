};

&crypto {
	status = "okay";
};

&dfi {
	status = "okay";
};

&dmc {
	center-supply = <&vdd_logic>;
	status = "okay";
};

&mailbox {
	status = "okay";
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&pcie2x1 {
	reset-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
        vpcie3v3-supply = <&vcc_3v3_s3>;
	status = "okay";
};

&pinctrl {
	charge {
		charge_pin: charge-pin {
			rockchip,pins = <4 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		full_pin: full-pin {
			rockchip,pins = <4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	lcd {
		lcd_dc_pin: lcd-dc-pin {
			rockchip,pins = <1 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up_drv_level_6>;
		};

		spi1_custom_pins: spi4-custom-pins {
			rockchip,pins =
				/* spi1_clk_m2 */
				<1 RK_PB6 2 &pcfg_pull_none_drv_level_2>,
				/* spi1_mosi_m2 */
				<1 RK_PB7 2 &pcfg_pull_none_drv_level_2>;
		};

		lcd_backlight_pin: lcd-backlight-pin {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	leds {
		led_dl1_pin: led-dl1-pin {
			rockchip,pins = <4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		led_dl2_pin: led-dl2-pin {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		led_dl3_pin: led-dl3-pin {
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		led_dl4_pin: led-dl4-pin {
			rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	sdio-wireless {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		wifi_wake_host_irq: wifi-wake-host-irq {
			rockchip,pins = <1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

};

&pwm0 {
	pinctrl-0 = <&pwm0m0_pins>;
	status = "okay";
};

&pwm1 {
	pinctrl-0 = <&pwm1m0_pins>;
	status = "okay";
};

&pwm2 {
	pinctrl-0 = <&pwm2m0_pins>;
	status = "okay";
};

&pwm4 {
	pinctrl-0 = <&pwm4m0_pins>;
	status = "okay";
};

&pwm5 {
	pinctrl-0 = <&pwm5m0_pins>;
	status = "okay";
};

&rga2 {
	status = "okay";
};

&rga2_mmu {
	status = "okay";
};

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&rkvtunnel {
	status = "okay";
};

&rng {
	status = "okay";
};

&saradc {
	status = "okay";
	vref-supply = <&vdd_1v8_s3>;
};

&sdhci {
	bus-width = <8>;
	no-sd;
	no-sdio;
	non-removable;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk &emmc_cmd &emmc_strb &emmc_bus8>;
	status = "okay";
};

&sdio0 {
	#address-cells = <1>;
	#size-cells = <0>;
	max-frequency = <150000000>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio0_bus4 &sdio0_clk &sdio0_cmd>;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	status = "okay";

	wifi@1 {
		compatible = "aic,aic8800-sdio";
		reg = <1>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_wake_host_irq>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PA7 IRQ_TYPE_LEVEL_HIGH>; /* WIFI_WAKE_HOST */
		interrupt-names = "host-wake";
	};
};

&tsadc {
	status = "okay";
};

&uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
};

&u2phy_host {
	phy-supply = <&vcc5v0_usb_devices>;
	status = "okay";
};

&u2phy_otg {
	phy-supply = <&vcc5v0_usb_devices>;
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usbdrd30 {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "host";
	extcon = <&usb2phy>;
	maximum-speed = "high-speed";
	phys = <&u2phy_otg>;
	phy-names = "usb2-phy";
	status = "okay";
};

&vdpp {
	status = "okay";
};

&vdpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&uart2 {
	status = "okay";
	pinctrl-names = "default";
	/* RTS is required for hardware flow control; the AIC8800 BT firmware
	 * is configured with flow control enabled (uart_flowctrl=1).
	 */
	pinctrl-0 = <&uart2m1_xfer &uart2m1_ctsn &uart2m1_rtsn>;

	bluetooth {
		compatible = "aic,aic8800-bt";
		enable-gpios = <&gpio1 RK_PC1 GPIO_ACTIVE_HIGH>;       /* BT_REG_ON */
		device-wakeup-gpios = <&gpio1 RK_PC0 GPIO_ACTIVE_HIGH>; /* HOST_WAKE_BT */
		host-wakeup-gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_HIGH>;   /* BT_WAKE_HOST */
		max-speed = <1500000>;
		post-power-on-delay-ms = <100>;
	};
};

&wdt {
	status = "okay";
};
