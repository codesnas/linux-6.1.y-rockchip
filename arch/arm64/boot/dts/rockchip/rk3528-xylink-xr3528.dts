	opp-600000000 {
		opp-microvolt-L0 = <905000 905000 1200000>;
		opp-microvolt-L1 = <895000 895000 1200000>;
		opp-microvolt-L2 = <885000 885000 1200000>;
		opp-microvolt-L3 = <875000 875000 1200000>;
