&mipi2_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_in: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csi2_dphy3_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&rkcif_mipi_lvds2_in>;
			};
		};
	};
};

&rkcif_mipi_lvds2 {
	status = "okay";

	port {
		rkcif_mipi_lvds2_in: endpoint {
			remote-endpoint = <&mipi2_csi2_out>;
		};
	};
};

&rkcif_mipi_lvds2_sditf {
	status = "okay";

	port {
		rkcif_mipi_lvds2_sditf_out: endpoint {
			remote-endpoint = <&rkisp_vir1_in>;
		};
	};
};

&rkisp_vir1 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		rkisp_vir1_in: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&rkcif_mipi_lvds2_sditf_out>;
		};
	};
};

&rkisp_vir1_sditf {
	status = "okay";
};

&rkvpss_vir1 {
	status = "okay";
};
