#include "rv1126b-xiaoyu-50ipc.dts"

/*
 * csi2_dphy0 -> csi0(rx0) clk0 + 4 lane ==> imx415_0
 *                           or + 2 lane ==> sc450ai_0
 * csi2_dphy1 -> csi0(rx0) clk0 + 2 lane 0/1
 * csi2_dphy2 -> csi0(rx0) clk1 + 2 lane 2/3
 * csi2_dphy3 -> csi1(rx1) clk0 + 4 lane ==> imx415_1
 *                           or + 2 lane ==> sc450ai_1
 * csi2_dphy4 -> csi1(rx1) clk0 + 2 lane 0/1
 * csi2_dphy5 -> csi1(rx1) clk1 + 2 lane 2/3
 */
&csi2_dphy3 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi2_dphy3_in1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&sc235hai_1_out>;
				data-lanes = <1 2>;
			};

			csi2_dphy3_in2: endpoint@2 {
				reg = <2>;
				remote-endpoint = <&sc450ai_1_out>;
				data-lanes = <1 2>;
			};

			csi2_dphy3_in3: endpoint@3 {
				reg = <3>;
				remote-endpoint = <&sc530ai_1_out>;
				data-lanes = <1 2 3 4>;
			};

			csi2_dphy3_in4: endpoint@4 {
				reg = <4>;
				remote-endpoint = <&imx415_1_out>;
				data-lanes = <1 2 3 4>;
			};

			csi2_dphy3_in5: endpoint@5 {
				reg = <5>;
				remote-endpoint = <&gc2093_1_out>;
				data-lanes = <1 2>;
			};

			csi2_dphy3_in6: endpoint@6 {
				reg = <6>;
				remote-endpoint = <&gc8613_1_out>;
				data-lanes = <1 2 3 4>;
			};

			csi2_dphy3_in7: endpoint@7 {
				reg = <7>;
				remote-endpoint = <&sc850sl_1_out>;
				data-lanes = <1 2 3 4>;
			};

			/*
			csi2_dphy3_in8: endpoint@8 {
				reg = <8>;
				remote-endpoint = <&imx586_1_out>;
				data-lanes = <1 2 3 4>;
			};
			*/

			/*
			csi2_dphy3_in9: endpoint@9 {
				reg = <9>;
				remote-endpoint = <&sc635ai_1_out>;
				data-lanes = <1 2 3 4>;
			};
			*/
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi2_dphy3_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi2_csi2_in>;
			};
		};
	};
};

/* sensor1 */
&i2c4 {
	pinctrl-0 = <&i2c4m2_pins>;
	status = "okay";

	sc235hai_1: sc235hai-1@30 {
		compatible = "smartsens,sc235hai";
		reg = <0x30>;
		clocks = <&cru CLK_MIPI1_OUT2IO>;
		clock-names = "xvclk";
		reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1_pins>;
		rockchip,camera-hdr-mode = <5>; //HDR_X2
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "xiaoyu";
		rockchip,camera-module-lens-name = "50ipc";
		status = "okay";

		port {
			sc235hai_1_out: endpoint {
				remote-endpoint = <&csi2_dphy3_in1>;
				data-lanes = <1 2>;
			};
		};
	};

	sc450ai_1: sc450ai-1@30 {
		compatible = "smartsens,sc450ai";
		reg = <0x30>;
		clocks = <&cru CLK_MIPI1_OUT2IO>;
		clock-names = "xvclk";
		reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1_pins>;
		rockchip,camera-hdr-mode = <5>; //HDR_X2
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "xiaoyu";
		rockchip,camera-module-lens-name = "50ipc";
		status = "okay";

		port {
			sc450ai_1_out: endpoint {
				remote-endpoint = <&csi2_dphy3_in2>;
				data-lanes = <1 2>;
			};
		};
	};

	sc530ai_1: sc530ai-1@32 {
		compatible = "smartsens,sc530ai";
		reg = <0x32>;
		clocks = <&cru CLK_MIPI1_OUT2IO>;
		clock-names = "xvclk";
		reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1_pins>;
		rockchip,camera-hdr-mode = <5>; //HDR_X2
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "xiaoyu";
		rockchip,camera-module-lens-name = "50ipc";
		status = "okay";

		port {
			sc530ai_1_out: endpoint {
				remote-endpoint = <&csi2_dphy3_in3>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	imx415_1: imx415-1@37 {
		compatible = "sony,imx415";
		reg = <0x37>;
		clocks = <&cru CLK_MIPI1_OUT2IO>;
		clock-names = "xvclk";
		reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk1_pins>;
		rockchip,camera-hdr-mode = <5>; //HDR_X2
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "xiaoyu";
		rockchip,camera-module-lens-name = "50ipc";
		status = "okay";

		port {
			imx415_1_out: endpoint {
				remote-endpoint = <&csi2_dphy3_in4>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	gc2093_1: gc2093-1@7e {
		compatible = "galaxycore,gc2093";
		reg = <0x7e>;
		clocks = <&cru CLK_MIPI1_OUT2IO>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam_clk1_pins>;
		rockchip,camera-hdr-mode = <5>; //HDR_X2
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "xiaoyu";
		rockchip,camera-module-lens-name = "50ipc";
		status = "okay";

		port {
			gc2093_1_out: endpoint {
